# The default static build needs no environment variables or private API keys.
# Sync script overrides are optional. These endpoints must serve the same public contracts.
REFERENCE_SITE_URL=https://arianwever.com/
SOURCE_API_URL=https://api.arianwever.com/

# Optional live shared map-planning rooms. Use your own Supabase project.
# Only a publishable anon key belongs in VITE_ variables; these are public in the browser.
# Enable public Realtime Broadcast channels in the project. Never use a service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional deployment hook: set as a GitHub Actions repository secret, not a VITE_ variable.
# DEPLOY_HOOK_URL=
